{
  "name": "@tanuden/kumoha-react",
  "version": "0.4.2",
  "main": "dist/index.js",
  "description": "React hooks for Tanuden Kumoha theming engine",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --config .prettierrc.cjs --write './**/*.{ts,tsx,js,jsx,cjs,json,yml,yaml}'",
    "format:check": "prettier --config .prettierrc.cjs --check './**/*.{ts,tsx,js,jsx,cjs,json,yml,yaml}'",
    "prepare": "husky"
  },
  "repository": {
    "url": "https://github.com/haruyukitanuki/kumoha-react"
  },
  "peerDependencies": {
    "@tanuden/kumoha": "^0.4.0"
  },
  "dependencies": {
    "deep-object-diff": "^1.1.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "opentetsu": "^0.0.9",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,json}": [
      "npm run format",
      "npm run format:check"
    ],
    "**/*.{ts,tsx,js,jsx,cjs}": [
      "npm run lint",
      "npm run lint:check"
    ]
  }
}
